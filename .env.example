# MongoDB Atlas 
MONGO="your_mongodb_uri"

# JWT Config
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"

# Email Configuration
EMAIL_USER="your_email_address"
EMAIL_PASS="your_email_password"

# Client URL (comma separated for multiple origins: local and hosted frontend)
# Example: http://localhost:5173 or http://localhost:5173,https://your-frontend.vercel.app
CLIENT_URL="http://localhost:5173"

# Backend & Keep-Alive Service
# Example: http://localhost:3000 or https://your-app.onrender.com
SERVER_URL="http://localhost:3000"
KEEP_ALIVE_INTERVAL_MINUTES=8
# Set to "true" only if you explicitly want to keep Render instances warm (burns free instance hours)
ENABLE_KEEP_ALIVE="false"

# GitHub Client Secrets
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
