# MongoDB Atlas 
MONGO="your_mongodb_uri"

# JWT Config
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"

# Email Configuration
EMAIL_USER="your_email_address"
EMAIL_PASS="your_email_password"

# Client URL (comma separated for multiple origins: local and hosted frontend)
CLIENT_URL="http://localhost:5173,https://gitmatch-delta.vercel.app"

# Hosted Backend & Keep-Alive Service
SERVER_URL="https://gitmatch-feqo.onrender.com"
KEEP_ALIVE_INTERVAL_MINUTES=8
ENABLE_KEEP_ALIVE="true"

# GitHub Client Secrets
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
